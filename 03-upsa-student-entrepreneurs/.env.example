# Password for the researcher dashboard and exports.
ADMIN_PASSWORD=change-me

# Production: Postgres connection string (e.g. from Neon). When set, it is used instead of SQLite.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Local fallback when DATABASE_URL is unset: SQLite file (default ./data/responses.db)
# DATABASE_PATH=./data/responses.db
